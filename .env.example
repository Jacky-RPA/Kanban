# Copia este archivo como .env y completa los valores. NUNCA subas .env al repositorio.
# En Vercel solo hace falta GEMINI_API_KEY (Settings → Environment Variables).

# Clave gratuita de Gemini para el Asistente IA: https://aistudio.google.com → Get API key
GEMINI_API_KEY=

# Modelo de Gemini (los "flash" están en el nivel gratuito) y modelo de respaldo si el principal está saturado
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_MODEL_RESPALDO=gemini-flash-latest

# Puerto del backend en local
PORT=3001
